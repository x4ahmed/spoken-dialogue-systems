#!/bin/bash

# Parameters ------------------------------------------------------

TASK="unified"
DATA_DIR=""
DATASET_CONFIG="dataset_config/unified_simplemultiwoz21.json"

# Project paths etc. ----------------------------------------------

OUT_DIR=results/simplemultiwoz21_mini
mkdir -p ${OUT_DIR}

# Main ------------------------------------------------------------

for step in train dev test; do
    args_add=""
    if [ "$step" = "train" ]; then
	args_add="--do_train --predict_type=dummy" # INFO: For sim-M, we recommend to add "--svd=0.3"
    elif [ "$step" = "dev" ] || [ "$step" = "test" ]; then
	args_add="--do_eval --predict_type=${step}"
    fi

    python3 run_dst.py \
        --task_name=${TASK} \
        --data_dir=${DATA_DIR} \
        --dataset_config=${DATASET_CONFIG} \
        --model_type="bert" \
        --model_name_or_path="prajjwal1/bert-mini" \
        --tokenizer_name="bert-base-uncased" \
        --do_lower_case \
        --learning_rate=1e-4 \
        --num_train_epochs=10 \
        --max_seq_length=180 \
        --per_gpu_train_batch_size=32 \
        --per_gpu_eval_batch_size=32 \
        --output_dir=${OUT_DIR} \
        --save_epochs=2 \
        --warmup_proportion=0.1 \
        --eval_all_checkpoints \
        --local_files_only \
        --adam_epsilon=1e-6 \
            --weight_decay=0.01 \
        ${args_add} \
        2>&1 | tee ${OUT_DIR}/${step}.log
    
    if [ "$step" = "dev" ] || [ "$step" = "test" ]; then
    	python3 metric_dst.py \
		--dataset_config=${DATASET_CONFIG} \
    		--file_list="${OUT_DIR}/pred_res.${step}*json" \
    		2>&1 | tee ${OUT_DIR}/eval_pred_${step}.log
    fi
done
